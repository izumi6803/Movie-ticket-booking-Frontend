{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Add grep MCP to search code examples across GitHub
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    // Add Context7 MCP to search documentation
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "rules": "AGENTS.md"
}
